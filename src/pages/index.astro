---
import Page from '../layouts/Page.astro';
import AgentSetup from '../components/AgentSetup.astro';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import CodeBlock from '../components/CodeBlock.astro';
import ReportPanel from '../components/ReportPanel.astro';
import Step from '../components/Step.astro';
import { href, GITHUB_URL } from '../lib/site';
import { softwareApplication } from '../lib/jsonld';
const yaml = "jobs:\n  a11y:\n    runs-on: windows-2022\n    steps:\n      - uses: actions/checkout@v7\n      - uses: a11ign/a11ign@<release-commit>\n        with:\n          url: https://example.com/contact\n          task: Send an enquiry";
---

<Page path="/" jsonLd={[softwareApplication()]}>
	<main id="main" tabindex="-1">
	    <section class="hero">
	      <div class="in">
	        <h1 class="x80">Test accessibility the way a screen reader user <span class="a1-hl">hears it.</span></h1>
	        <p class="lead">a11ign runs a real screen reader (NVDA) over your pages and shows you the barriers it hits, with the exact words it said.</p>
	        <div class="btns">
	          <Button size="lg" href={href('/get-started')}>Add to your workflow</Button>
	          <Button size="lg" variant="secondary" icon="github" href={GITHUB_URL}>Star on GitHub</Button>
	        </div>
	        <p class="aud">For developers and QA teams who ship web apps.</p>
	        <ul class="facts" aria-label="Key facts"><li>Free and open source</li><li>No data sent to us</li></ul>
	      </div>
	    </section>
	
	    <section class="sec band" aria-labelledby="pts">
	      <div class="in stack">
	        <h2 id="pts" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap">What a11ign does</h2>
	        <div class="cards3">
	          <div><Card title={"A real screen reader, not a guess."}>a11ign runs NVDA, a free Windows screen reader, over your page and records what it says.</Card></div>
	          <div><Card title={"Every finding shows its proof."}>Each finding names the WCAG 2.2 rule it breaks and quotes what the screen reader said, so you can check it yourself.</Card></div>
	          <div><Card title={"Findings land in your pull request."}>The report appears as a comment on your pull request, so you see problems where you already review code.</Card></div>
	        </div>
	      </div>
	    </section>
	
	    <section class="sec" aria-labelledby="how">
	      <div class="in stack" style="gap:var(--space-7)">
	        <div class="sh"><span class="num" aria-hidden="true">01</span><h2 id="how" class="x44">How it works</h2></div>
	        <div class="how">
	          <ul class="steps list">
	            <li><Step>Add a few lines to your GitHub project.</Step></li>
	            <li><Step>GitHub runs a11ign on a Windows machine, with a real screen reader.</Step></li>
	            <li><Step>Read the report on your pull request.</Step></li>
	          </ul>
	          <div class="code"><CodeBlock label={".github/workflows/a11ign.yml"} code={yaml} /></div>
	        </div>
	      </div>
	    </section>
	
	    <section class="sec band" aria-labelledby="agent">
	      <div class="in rep">
	        <div class="repL">
	          <div class="sh"><span class="num" aria-hidden="true">02</span><h2 id="agent" class="x44">Let your AI agent set it up</h2></div>
	          <p class="body" style="color:var(--text-muted)">Install the skill, then ask in plain words. Your agent opens a pull request for you to review.</p>
	        </div>
	        <div class="repR"><AgentSetup numbered={false} /></div>
	      </div>
	          <div class="in" style="margin-top:var(--space-5)"><a class="lnk" href={href('/get-started') + '#agent'}>Use another agent, or paste a prompt instead</a></div>
	    </section>
	
	    <section class="sec" aria-labelledby="rep">
	      <div class="in rep">
	        <div class="repL">
	          <div class="sh"><span class="num" aria-hidden="true">03</span><h2 id="rep" class="x44">What a report looks like</h2></div>
	          <p class="body" style="color:var(--text-muted)">Each finding names the WCAG 2.2 rule it breaks and quotes the exact words the screen reader said.</p>
	        </div>
	        <figure class="repR">
	          <ReportPanel />
	          <figcaption class="small" style="color:var(--text-muted)">A real run against example.com. The evidence line is what NVDA said.</figcaption>
	        </figure>
	      </div>
	    </section>
	
	    <section class="sec band" aria-labelledby="two">
	      <div class="in stack" style="gap:var(--space-7)">
	        <div class="sh"><span class="num" aria-hidden="true">04</span><h2 id="two" class="x44">Two ways to check</h2></div>
	        <div class="two">
	          <div class="twoc">
	            <span class="ttag">Available now</span>
	            <h3 class="h3" style="font-weight:800">Real NVDA, before you release</h3>
	            <p class="body" style="color:var(--text-muted)">Drives real NVDA over your pages and quotes what it said, as a comment on your pull request. Run it before a release and on the flows that matter. The proof is the words NVDA said.</p>
	          </div>
	          <div class="twoc soon">
	            <Badge>Coming soon</Badge>
	            <h3 class="h3" style="font-weight:800">A quick check in the tests you already run</h3>
	            <p class="body" style="color:var(--text-muted)">Predicts what NVDA would say without a screen reader, on any operating system, so it can run on every commit. It’s always labelled a prediction, never proof. A real NVDA run confirms it.</p>
	            <a class="lnk" href={GITHUB_URL}>Star the project to follow it</a>
	          </div>
	        </div>
	      </div>
	    </section>
	
	    <section class="sec" aria-labelledby="lim">
	      <div class="in stack">
	        <div class="sh"><span class="num" aria-hidden="true">05</span><h2 id="lim" class="x44">What to expect</h2></div>
	        <ul class="lim">
	          <li>Proof, not a score: every finding quotes what the screen reader said.</li>
	          <li>Evidence you can act on, alongside your own judgement and legal advice.</li>
	          <li>Focused on the pages you choose, like checkout, sign-up and search.</li>
	          <li>Some findings say “worth a look”, because a person makes the final call.</li>
	          <li>No Windows machine needed: GitHub provides one when you use the Action.</li>
	        </ul>
	        <p class="body" style="color:var(--text-muted);max-width:70ch">What we’ve measured: across 1,405 records of pages that meet the standard, the exact rules raised no false alarms. That’s our own test set, so treat it as a starting point. <a class="lnk" href={href('/docs')} style="min-height:0">How we know it works</a></p>
	      </div>
	    </section>
	
	    <section class="mission">
	      <div class="in">
	        <blockquote style="margin:0">
	          <div class="qm" aria-hidden="true">“</div>
	          <p class="q">Good accessibility testing starts with what people actually hear, not just what the code says. a11ign gives you proof you can check, so you find the barriers before your users do.</p>
	        </blockquote>
	      </div>
	    </section>
	
	    <section class="sec" aria-labelledby="close" style="padding-top:0">
	      <div class="in">
	        <div class="bn">
	          <div class="bnT">
	            <h2 id="close" class="x44" style="max-width:18ch">Add a11ign to your workflow and see your first report.</h2>
	            <div class="btns" style="justify-content:flex-start">
	              <Button size="lg" href={href('/get-started')}>Add to your workflow</Button>
	              <Button size="lg" variant="secondary" icon="github" href={GITHUB_URL}>Star on GitHub</Button>
	            </div>
	          </div>
	          <svg class="bands" viewBox="0 0 480 288" aria-hidden="true" focusable="false">
	            <rect class="band5 p1" x="0" y="8" width="400" height="48"/>
	            <rect class="band5 p2" x="40" y="64" width="440" height="48"/>
	            <rect class="band5 p3" x="0" y="120" width="360" height="48"/>
	            <rect class="band5 p4" x="80" y="176" width="400" height="48"/>
	            <rect class="band5 p5" x="0" y="232" width="296" height="48"/>
	            <rect class="word" x="24" y="26" width="56" height="12"/><rect class="word" x="96" y="26" width="40" height="12"/><rect class="word" x="152" y="26" width="80" height="12"/><rect class="word" x="248" y="26" width="48" height="12"/><rect class="word" x="312" y="26" width="64" height="12"/>
	            <rect class="word" x="64" y="82" width="64" height="12"/><rect class="word" x="144" y="82" width="40" height="12"/><rect class="word" x="200" y="82" width="88" height="12"/><rect class="word" x="304" y="82" width="40" height="12"/><rect class="word" x="360" y="82" width="56" height="12"/>
	            <rect class="word" x="24" y="138" width="48" height="12"/><rect class="word" x="88" y="138" width="72" height="12"/><rect class="word" x="176" y="138" width="40" height="12"/><rect class="word" x="232" y="138" width="64" height="12"/>
	            <rect class="word" x="104" y="194" width="88" height="12"/><rect class="word" x="208" y="194" width="40" height="12"/><rect class="word" x="264" y="194" width="56" height="12"/><rect class="word" x="336" y="194" width="72" height="12"/><rect class="word" x="424" y="194" width="40" height="12"/>
	            <rect class="word" x="24" y="250" width="40" height="12"/><rect class="word" x="80" y="250" width="64" height="12"/><rect class="word" x="160" y="250" width="48" height="12"/>
	          </svg>
	        </div>
	      </div>
	    </section>
	  </main>
</Page>

<style is:global>
body{margin:0}
.pg,.pg *{box-sizing:border-box}
.pg{width:100%;min-height:100vh;display:flex;flex-direction:column;background:var(--ground);color:var(--text);font:400 18px/1.6 var(--font-sans)}
.pg h1,.pg h2,.pg h3,.pg p{margin:0}
.pg h1,.pg h2,.pg h3{text-wrap:balance}
.pg main{display:block}
.pg main:focus{outline:none}
.in{max-width:1280px;margin:0 auto;width:100%}
.sec{padding:112px 80px}
.band{background:var(--band);border-top:1px solid var(--divider);border-bottom:1px solid var(--divider)}
.hero{padding:128px 80px 144px}
.hero .in{display:flex;flex-direction:column;align-items:center;text-align:center;gap:32px}
.x80{font:800 80px/1.04 var(--font-display);letter-spacing:-.03em;max-width:15ch}
.x44{font:800 44px/1.15 var(--font-display);letter-spacing:-.02em}
.lead{font-size:22px;line-height:1.6;color:var(--text-muted);max-width:44ch}
.btns{display:flex;gap:16px;justify-content:center}
.stack{display:flex;flex-direction:column;gap:var(--space-6)}
.cards3{display:flex;gap:24px}
.cards3>div{flex:1 1 0;min-width:0;display:flex}
.cards3>div>*{width:100%}
.rep{display:flex;gap:72px;align-items:center}
.repL{width:420px;flex:none;display:flex;flex-direction:column;gap:16px}
.repR{flex:1 1 0;min-width:0;margin:0;display:flex;flex-direction:column;gap:16px}
.how{display:flex;gap:48px;align-items:flex-start}
.steps{list-style:none;margin:0;padding:0;width:460px;flex:none;display:flex;flex-direction:column;gap:32px}
.steps.list>li::before{top:.42em}
.code{flex:1 1 0;min-width:0;width:100%}
.pyr{width:960px;max-width:100%;margin:0 auto;display:flex;flex-direction:column;align-items:center;gap:10px}
.tt{width:54%;clip-path:polygon(10% 0,90% 0,100% 100%,0 100%);padding:28px 72px 30px;text-align:center;display:flex;flex-direction:column;gap:6px;background:var(--pen);color:var(--ink)}
[data-theme="light"] .tt{background:var(--ink);color:var(--pen-highlighter)}
.tb{width:100%;background:var(--edge);clip-path:polygon(4% 0,96% 0,100% 100%,0 100%);padding:2px}
.tbi{background:var(--surface);clip-path:polygon(4% 0,96% 0,100% 100%,0 100%);padding:40px 96px 44px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:16px}
.two{display:flex;gap:24px;align-items:stretch}
.twoc{flex:1 1 0;min-width:0;display:flex;flex-direction:column;align-items:flex-start;gap:14px;padding:32px;background:var(--surface);border:1px solid var(--divider);border-top:4px solid var(--pen);border-radius:var(--radius-lg);box-shadow:var(--shadow-card)}
[data-theme="light"] .twoc{border-top-color:var(--ink)}
.twoc.soon{border-top-color:var(--edge)}
.ttag{display:inline-flex;align-items:center;min-height:32px;padding:0 14px;border-radius:var(--radius-pill);background:var(--pen);color:var(--ink);font:700 15px/1 var(--font-sans);letter-spacing:.04em;text-transform:uppercase}
[data-theme="light"] .ttag{background:var(--ink);color:var(--pen-highlighter)}
.aud{margin:0;color:var(--text-muted);font:400 18px/1.5 var(--font-sans)}
.facts{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;justify-content:center;gap:10px 12px}
.facts li{padding:6px 14px;border:1px solid var(--edge);border-radius:var(--radius-pill);font:600 15px/1.3 var(--font-sans);color:var(--text)}
.lim{list-style:none;margin:0;padding:0;max-width:880px;background:var(--surface);border:1px solid var(--divider);border-radius:var(--radius-lg);box-shadow:var(--shadow-card)}
.lim li{display:flex;gap:16px;align-items:flex-start;padding:24px 32px;border-top:1px solid var(--divider);font-size:21px;line-height:1.5}
.lim li:first-child{border-top:0}
.lim li::before{content:"";flex:none;width:12px;height:12px;margin-top:11px;border-radius:50%;background:var(--pen-text)}
.mission{padding:128px 80px}
.qm{font:800 120px/.8 var(--font-display);color:var(--pen-text)}
.q{font:600 42px/1.3 var(--font-display);letter-spacing:-.015em;margin-top:12px;max-width:1000px}
.bn{background:var(--surface);border:1px solid var(--divider);border-radius:var(--radius-xl);box-shadow:var(--shadow-card);padding:64px 56px;display:flex;align-items:center;gap:48px;overflow:hidden}
.bnT{flex:1 1 0;min-width:0;display:flex;flex-direction:column;gap:24px;align-items:flex-start}
.bands{flex:none;width:480px;height:auto}
.p1{fill:var(--pen-highlighter)}.p2{fill:var(--pen-flamingo)}.p3{fill:var(--pen-tangerine)}.p4{fill:var(--pen-sky)}.p5{fill:var(--pen-grape)}
.band5{rx:var(--radius-sm)}.word{fill:var(--surface);rx:var(--radius-sm)}
.lnk{display:inline-flex;align-items:center;min-height:var(--touch-target);color:var(--link);font:600 18px/1.2 var(--font-sans);text-decoration:underline;text-underline-offset:5px;text-decoration-thickness:2px}
.lnk:focus-visible{outline:var(--focus-width) solid var(--focus);outline-offset:3px;border-radius:8px}
.pg .a1-card{padding:var(--space-6);border-top:4px solid var(--pen)}
[data-theme="light"] .pg .a1-card{border-top-color:var(--ink)}
.pg .a1-code{max-width:100%}
.pg .a1-code-head>span:first-child{min-width:0;overflow-wrap:anywhere}
.pg .a1-step-t{min-width:0;overflow-wrap:anywhere}
.prompt .a1-code{max-width:none;width:100%}
.prompt .a1-code-body{white-space:pre-wrap;overflow-wrap:anywhere;font-size:15px}

@media (max-width:860px){
  .sec{padding:56px 20px}
  .hero{padding:56px 20px 64px}
  .hero .in{gap:24px}
  .facts{justify-content:flex-start}
  .x80{font-size:40px}
  .x44{font-size:32px}
  .lead{font-size:19px}
  .btns{flex-direction:column;width:100%}
  .cards3{flex-direction:column}
  .rep,.how{flex-direction:column}
  .rep{gap:32px;align-items:stretch}
  .repL,.steps{width:100%}
  .how{gap:32px}
  .two{flex-direction:column}
  .twoc{padding:24px}
  .tt{width:78%;padding:24px 38px 26px}
  .tbi{padding:32px 40px 36px}
  .lim li{padding:20px;font-size:19px}
  .mission{padding:72px 20px}
  .qm{font-size:72px}
  .q{font-size:26px}
  .bn{flex-direction:column-reverse;padding:36px 20px;gap:32px}
  .bands{width:100%}
  .pg .a1-card{padding:var(--space-5)}
}
@media (max-width:860px){.prompt .a1-code-body{max-height:360px;overflow-y:auto}}
@media (prefers-reduced-motion:reduce){.pg *{transition:none!important}}
</style>
