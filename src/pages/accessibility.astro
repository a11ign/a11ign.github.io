---
import '../styles/kit.css';
import Page from '../layouts/Page.astro';
import { href } from '../lib/site';

---

<Page path="/accessibility">
	<main id="main" tabindex="-1">
	    <div class="bd first"><div class="wrap"><h1 class="t60">Accessibility statement</h1></div><div class="wrap prose"><p>Last updated: 24 October 2026</p></div></div>
	    <div class="bd"><section class="wrap prose" aria-labelledby="a1" style="gap:var(--space-4)"><div class="sh"><h2 id="a1" class="t28">Our commitment</h2></div>
	<p>a11ign exists to make the web work for people who use screen readers, so <span class="hl">this website should work for them too.</span></p>
	    </section></div>
	    <div class="bd"><section class="wrap prose" aria-labelledby="a2" style="gap:var(--space-4)"><div class="sh"><h2 id="a2" class="t28">Where we are today</h2></div>
	<p>We aim to meet WCAG 2.2 level AA on every page of this website.</p>
	    </section></div>
	    <div class="bd"><section class="wrap prose" aria-labelledby="a3" style="gap:var(--space-4)"><div class="sh"><h2 id="a3" class="t28">How we check</h2></div>
	<p>We check pages with a11ign and axe-core, and test by hand with a screen reader and a keyboard.</p>
	    </section></div>
	    <div class="bd"><section class="wrap prose" aria-labelledby="a4" style="gap:var(--space-4)"><div class="sh"><h2 id="a4" class="t28">Known problems</h2></div>
	<p>None that we know of, as of the date above.</p>
	    </section></div>
	    <div class="bd"><section class="wrap prose" aria-labelledby="a5" style="gap:var(--space-4)"><div class="sh"><h2 id="a5" class="t28">Tell us about a problem</h2></div>
	<p>If something on this site is hard to use, email hello@a11ign.com. We’ll reply within 2 working days and tell you what we’ll do about it.</p>
	    </section></div>
	  </main>
</Page>

