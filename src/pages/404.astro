---
import '../styles/kit.css';
import Page from '../layouts/Page.astro';
import Button from '../components/Button.astro';
import { href } from '../lib/site';
---

<Page path="/404" title="Page not found" noindex>
	<main id="main" tabindex="-1">
	    <div class="bd first"><div class="wrap"><h1 class="t60">We can’t find that page</h1></div></div>
	    <div class="bd"><section class="wrap" style="gap:var(--space-5)"><p class="lead">It may have moved, or the link might be wrong. Here’s where to go next.</p><div class="ctaRow"><Button size="lg" href={href('/')}>Go to the home page</Button><Button size="lg" variant="secondary" href={href('/docs')}>Read the docs</Button></div><p class="muted">Or try <a class="lnk2" href={href('/get-started')}>Get started</a>, <a class="lnk2" href={href('/what-it-checks')}>What it checks</a>, <a class="lnk2" href={href('/faq')}>the FAQ</a> or <a class="lnk2" href={href('/contact')}>Contact and support</a>.</p></section></div>
	  </main>
</Page>

