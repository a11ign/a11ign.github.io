---
import Page from '../layouts/Page.astro';
import { href } from '../lib/site';

---

<Page path="/cookies">
	<main id="main" tabindex="-1">
	    <div class="wrap"><h1 class="t60">Cookie <span class="a1-hl">policy</span></h1></div>
	
	<div class="wrap prose"><p>Last updated: 24 October 2026</p></div>
	    <section class="wrap prose" aria-labelledby="c1" style="gap:var(--space-4)"><h2 id="c1" class="t28">Cookies</h2>
	<p>Cookies are small files that a website saves on your device. This page covers this website. The a11ign software doesn’t use cookies.</p>
	    </section>
	    <section class="wrap prose" aria-labelledby="c2" style="gap:var(--space-4)"><h2 id="c2" class="t28">What we use</h2>
	<table class="cookt"><thead><tr><th scope="col">Type</th><th scope="col">What it does</th></tr></thead><tbody><tr><td>Essential cookies</td><td>None. This site doesn’t set any.</td></tr><tr><td>Analytics cookies</td><td>None. We count visits with a tool that doesn’t use cookies.</td></tr></tbody></table>
	    </section>
	    <section class="wrap prose" aria-labelledby="c3" style="gap:var(--space-4)"><h2 id="c3" class="t28">If this changes</h2>
	<p>If we ever add something that uses cookies, we’ll ask for your consent first and list each cookie here.</p>
	    </section>
	  </main>
</Page>

<style is:global>
body{margin:0}
.pg,.pg *{box-sizing:border-box}
.pg{width:100%;min-height:100vh;display:flex;flex-direction:column;background:var(--ground);color:var(--text);font:400 18px/1.6 var(--font-sans)}
.pg h1,.pg h2,.pg h3,.pg p{margin:0}
.pg h1,.pg h2,.pg h3{text-wrap:balance}
.pg main{display:flex;flex-direction:column;gap:72px;padding:88px 80px 120px}
.pg main:focus{outline:none}
.wrap{max-width:1040px;width:100%;margin:0 auto;display:flex;flex-direction:column;gap:var(--space-5)}
.t60{font:800 60px/1.05 var(--font-display);letter-spacing:-.03em}
.t36{font:800 36px/1.2 var(--font-display);letter-spacing:-.02em}
.lead{font-size:22px;color:var(--text-muted);max-width:60ch}
.muted{color:var(--text-muted)}
.grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}
.grid li{display:flex}.grid li>*{width:100%}
.grid .a1-card{border-top:4px solid var(--pen);padding-top:var(--space-5)}
.grid li>*,.grid .a1-card{width:100%;max-width:none}
[data-theme="light"] .grid .a1-card{border-top-color:var(--ink)}
.g3{grid-template-columns:repeat(3,minmax(0,1fr))}
.cmp{width:100%;border-collapse:separate;border-spacing:0;border:1px solid var(--divider);border-radius:var(--radius-lg);overflow:hidden;background:var(--surface)}
.cmp th,.cmp td{text-align:left;vertical-align:top;padding:16px 20px;border-top:1px solid var(--divider);font-size:17px;line-height:1.5}
.cmp thead th{border-top:0;font:600 16px/1.3 var(--font-sans);background:var(--band)}
.cmp tbody th{font-weight:600;width:22%}
.pill{display:inline-flex;align-self:flex-start;padding:4px 12px;border-radius:var(--radius-pill);border:1px solid var(--edge);font:600 14px/1.3 var(--font-mono)}
.pred{background:var(--pen);color:var(--ink);border-color:var(--pen)}
[data-theme="light"] .pred{background:var(--ink);color:var(--pen-highlighter);border-color:var(--ink)}
.list{margin:0;padding-left:22px;display:flex;flex-direction:column;gap:10px}
.ph{padding:20px 24px;border:2px dashed var(--edge);border-radius:var(--radius-lg);color:var(--text-muted)}
.faq{display:flex;flex-direction:column;border:1px solid var(--divider);border-radius:var(--radius-lg);background:var(--surface);overflow:hidden}
.faq details{border-top:1px solid var(--divider)}
.faq details:first-child{border-top:0}
.faq summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:var(--touch-target);padding:20px 28px;font:600 20px/1.4 var(--font-sans)}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"+";flex:none;font:600 28px/1 var(--font-mono);color:var(--pen-text)}
.faq details[open] summary::after{content:"\2212"}
.faq summary:focus-visible{outline:var(--focus-width) solid var(--focus);outline-offset:-4px;border-radius:8px}
.faq .ans{padding:0 28px 24px;color:var(--text-muted);max-width:70ch}
.ctaRow{display:flex;flex-wrap:wrap;gap:16px}
.person{display:flex;gap:20px;align-items:flex-start;padding:24px;border:1px solid var(--divider);border-top:4px solid var(--pen);border-radius:var(--radius-lg);background:var(--surface);box-shadow:var(--shadow-card)}
[data-theme="light"] .person{border-top-color:var(--ink)}
.grid .person>.av{flex:none;width:88px;height:88px}
.grid .person>div:last-child{flex:1 1 0;min-width:0;width:auto}
.av{flex:none;width:88px;height:88px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--pen);color:var(--ink);font:800 30px/1 var(--font-display);letter-spacing:-.02em}
[data-theme="light"] .av{background:var(--ink);color:var(--pen-highlighter)}
.t22{font:600 22px/1.25 var(--font-display);letter-spacing:-.01em;margin:0 0 2px}
.person p{margin:4px 0 0}
.lnk2{color:var(--link);font-weight:600;text-decoration:underline;text-underline-offset:4px;text-decoration-thickness:2px}
.lnk2:focus-visible{outline:var(--focus-width) solid var(--focus);outline-offset:3px;border-radius:6px}
.soc{display:flex;flex-wrap:wrap;gap:12px}
@media (max-width:1100px){.g3{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:860px){
 .pg main{padding:48px 20px 72px;gap:48px}
 .t60{font-size:38px}.t36{font-size:28px}.lead{font-size:19px}
 .grid,.g3{grid-template-columns:minmax(0,1fr);gap:16px}
 .person{flex-direction:column;gap:14px}
 .ctaRow{flex-direction:column}
 .cmp,.cmp tbody,.cmp tr,.cmp td,.cmp th{display:block;width:100%}
 .cmp thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
 .cmp tbody th{width:100%;background:var(--band);padding:12px 16px}.cmp td{padding:12px 16px;border-top:0}
 .cmp td::before{content:attr(data-l);display:block;font:600 13px/1.3 var(--font-mono);color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em}
 .faq summary{padding:16px 18px;font-size:18px}.faq .ans{padding:0 18px 20px}
}
.prose{max-width:1040px}
.prose p,.prose li{max-width:70ch;color:var(--text-muted);font-size:18px;line-height:1.7;margin:0}
.prose ul{margin:0;padding-left:22px;display:flex;flex-direction:column;gap:8px}
.prose strong{color:var(--text)}
.t28{font:800 28px/1.2 var(--font-display);letter-spacing:-.02em}
.draft{padding:16px 20px;border:2px dashed var(--edge);border-radius:var(--radius-lg);color:var(--text-muted);font-size:16px;line-height:1.5}
.cookt{width:100%;border-collapse:collapse;font-size:16px}
.cookt th,.cookt td{text-align:left;padding:10px 12px 10px 0;border-top:1px solid var(--divider);color:var(--text-muted);vertical-align:top}
.cookt th{font:400 14px/1.3 var(--font-mono);letter-spacing:.06em;text-transform:uppercase}
</style>
