---
import '../styles/kit.css';
import Page from '../layouts/Page.astro';
import { href } from '../lib/site';

---

<Page path="/cookies">
	<main id="main" tabindex="-1">
	    <div class="bd first"><div class="wrap"><h1 class="t60">Cookie policy</h1></div><div class="wrap prose"><p>Last updated: 24 October 2026</p></div></div>
	    <div class="bd"><section class="wrap prose" aria-labelledby="c1" style="gap:var(--space-4)"><div class="sh"><h2 id="c1" class="t28">Cookies</h2></div>
	<p>Cookies are small files that a website saves on your device. This page covers this website. <span class="hl">The a11ign software doesn’t use cookies.</span></p>
	    </section></div>
	    <div class="bd"><section class="wrap prose" aria-labelledby="c2" style="gap:var(--space-4)"><div class="sh"><h2 id="c2" class="t28">What we use</h2></div>
	<table class="cookt"><thead><tr><th scope="col">Type</th><th scope="col">What it does</th></tr></thead><tbody><tr><td>Essential cookies</td><td>None. This site doesn’t set any.</td></tr><tr><td>Analytics cookies</td><td>None. We count visits with a tool that doesn’t use cookies.</td></tr></tbody></table>
	    </section></div>
	    <div class="bd"><section class="wrap prose" aria-labelledby="c3" style="gap:var(--space-4)"><div class="sh"><h2 id="c3" class="t28">If this changes</h2></div>
	<p>If we ever add something that uses cookies, we’ll ask for your consent first and list each cookie here.</p>
	    </section></div>
	  </main>
</Page>

