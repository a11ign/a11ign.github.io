---
import Page from '../layouts/Page.astro';
import { href, RESOURCES_META } from '../lib/site';
import { resourcePosts, resourcesLive } from '../data/resources';

// The chips and the "All resources" section show only when Resources is live (src/data/resources.ts).
const kinds = { 'How-tos': 'How-to', Guides: 'Guide', Articles: 'Article', 'Worked examples': 'Worked example' } as const;
const chips = ['All', ...Object.keys(kinds)];
const posts = resourcePosts;
---

<Page path="/resources" title={RESOURCES_META.title} description={RESOURCES_META.description} noindex={!resourcesLive}>
	<main id="main" tabindex="-1" data-filter-root={resourcesLive ? '' : undefined}>
	    <div class="wrap hd">
	      <h1 class="t80">Resources</h1>
	      <p class="lead">How-tos, guides and articles to help you test with a real screen reader.</p>
	      {resourcesLive && (
	        <div role="group" aria-label="Filter resources" class="chips">
	          {chips.map((chip) => (
	            <button type="button" class="chipb" aria-pressed={String(chip === 'All')} data-chip={chip} data-kind={kinds[chip as keyof typeof kinds]}>{chip}</button>
	          ))}
	        </div>
	      )}
	    </div>
	
	    <section class="wrap" aria-label="Featured">
	      <article class="rc feat">
	        <div class="featC" aria-hidden="true">
	          <svg viewBox="0 0 480 288" focusable="false">
	            <rect class="band5 p1" x="0" y="8" width="400" height="48"/><rect class="band5 p2" x="40" y="64" width="440" height="48"/><rect class="band5 p3" x="0" y="120" width="360" height="48"/><rect class="band5 p4" x="80" y="176" width="400" height="48"/><rect class="band5 p5" x="0" y="232" width="296" height="48"/>
	            <rect class="word" x="24" y="26" width="56" height="12"/><rect class="word" x="96" y="26" width="40" height="12"/><rect class="word" x="152" y="26" width="80" height="12"/><rect class="word" x="64" y="82" width="64" height="12"/><rect class="word" x="144" y="82" width="40" height="12"/><rect class="word" x="24" y="138" width="48" height="12"/><rect class="word" x="104" y="194" width="88" height="12"/><rect class="word" x="24" y="250" width="40" height="12"/>
	          </svg>
	        </div>
	        <div class="featT">
	          <span class="tag">Start here</span>
	          <h2 class="t38"><a href={href('/get-started')}>How to run a11ign on your first page</a></h2>
	          <p class="body" style="color:var(--text-muted)">[Placeholder: two sentences on what this guide covers and who it’s for.]</p>
	          <p class="small" style="color:var(--text-muted)">[Author] · [Date] · [Read time]</p>
	        </div>
	      </article>
	    </section>
	
	    {resourcesLive && (
	      <section class="wrap list-sh" aria-labelledby="all">
	        <div class="sh"><h2 id="all" class="h2" data-list-title>All resources</h2></div>
	        <p class="small" role="status" style="color:var(--text-muted)" data-count>Showing {posts.length} of {posts.length} resources</p>
	        <ul class="grid">
	          {posts.map((p) => (
	            <li data-kind={p.kind}>
	              <article class="rc" style="width:100%">
	                <div class="body2">
	                  <span class="tag">{p.kind}</span>
	                  <h3 class="h3"><a href={p.href.startsWith('/') ? href(p.href) : p.href}>{p.title}</a></h3>
	                  <p class="body" style="color:var(--text-muted)">{p.desc}</p>
	                  <p class="small" style="margin-top:auto;color:var(--text-muted)">{p.byline}</p>
	                </div>
	              </article>
	            </li>
	          ))}
	        </ul>
	      </section>
	    )}
	  </main>
</Page>

<script>
	import { setupFilter } from '../scripts/filter';
	setupFilter();
</script>

<style is:global>
body{margin:0}
.pg,.pg *{box-sizing:border-box}
.pg{width:100%;min-height:100vh;display:flex;flex-direction:column;background:var(--ground);color:var(--text);font:400 18px/1.6 var(--font-sans)}
.pg h1,.pg h2,.pg h3,.pg p{margin:0}
.pg h1,.pg h2,.pg h3{text-wrap:balance}
.pg main{display:flex;flex-direction:column;gap:64px;padding:88px 80px 120px}
.pg main:focus{outline:none}
.wrap{max-width:1280px;width:100%;margin:0 auto}
.list-sh{display:flex;flex-direction:column;gap:var(--space-5)}
.hd{display:flex;flex-direction:column;gap:16px}
.t80{font:800 80px/1.05 var(--font-display);letter-spacing:-.03em}
.t38{font:800 38px/1.15 var(--font-display);letter-spacing:-.02em}
.lead{font-size:22px;color:var(--text-muted);max-width:56ch}
.chips{display:flex;flex-wrap:wrap;gap:12px;margin-top:12px}
html:not(.js) .chips{display:none}
.p1{fill:var(--pen-highlighter)}.p2{fill:var(--pen-flamingo)}.p3{fill:var(--pen-tangerine)}.p4{fill:var(--pen-sky)}.p5{fill:var(--pen-grape)}
.band5{rx:var(--radius-sm)}.word{fill:var(--band);rx:var(--radius-sm)}
.chipb{display:inline-flex;align-items:center;min-height:var(--touch-target);padding:0 20px;border-radius:var(--radius-pill);border:2px solid var(--edge);background:transparent;color:var(--text);font:600 16px/1 var(--font-sans);cursor:pointer}
.chipb:hover{background:var(--raised)}
.chipb[aria-pressed="true"]{background:var(--pen);color:var(--ink);border-color:var(--pen)}
[data-theme="light"] .chipb[aria-pressed="true"]{background:var(--ink);color:var(--pen-highlighter);border-color:var(--ink)}
.chipb:focus-visible,.rc a:focus-visible{outline:var(--focus-width) solid var(--focus);outline-offset:3px;border-radius:8px}
.tag{display:inline-flex;align-items:center;align-self:flex-start;min-height:28px;padding:0 12px;border-radius:var(--radius-pill);border:1px solid var(--edge);color:var(--text);font:600 14px/1 var(--font-mono);letter-spacing:.03em}
.rc:not(.feat){border-top:4px solid var(--pen)}
[data-theme="light"] .rc:not(.feat){border-top-color:var(--ink)}
.rc{position:relative;display:flex;flex-direction:column;overflow:hidden;background:var(--surface);border:1px solid var(--divider);border-radius:var(--radius-lg);box-shadow:var(--shadow-card);color:var(--text)}
.rc a{color:var(--text);text-decoration:none}
.rc a::after{content:"";position:absolute;inset:0}
.rc a:hover{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:5px}
.rc:has(a:focus-visible){outline:var(--focus-width) solid var(--focus);outline-offset:3px}
.rc a:focus-visible{outline:none}
.feat{flex-direction:row;border-radius:var(--radius-xl)}
.featC{flex:none;width:520px;background:var(--band);display:flex;align-items:center;justify-content:center;padding:var(--space-6)}
.featC svg{width:100%;height:auto;max-width:440px}
.featT{flex:1 1 0;min-width:0;padding:56px;display:flex;flex-direction:column;justify-content:center;gap:var(--space-4)}
.grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3, minmax(0, 1fr));gap:var(--space-5)}
.grid li{display:flex}
.cov{height:150px;background:var(--band);display:flex;align-items:center;padding:0 var(--space-5)}
.cov svg{width:100%;height:auto}
.body2{padding:var(--space-5) var(--space-5) var(--space-6);display:flex;flex-direction:column;gap:var(--space-3);flex:1 1 auto}
@media (max-width:1100px){.grid{grid-template-columns:repeat(2, minmax(0, 1fr))}}
@media (max-width:860px){
  .pg main{padding:48px 20px 72px;gap:40px}
  .t80{font-size:48px}
  .t38{font-size:28px}
  .lead{font-size:19px}
  .feat{flex-direction:column}
  .featC{width:100%;padding:var(--space-5)}
  .featT{padding:28px 24px 32px}
  .grid{grid-template-columns:minmax(0, 1fr)}
}
</style>
