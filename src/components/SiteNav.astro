---
import { GITHUB_URL, href } from '../lib/site';
import { resourcesLive } from '../data/resources';
import Button from './Button.astro';
import StarPill from './StarPill.astro';
import Logo from './Logo.astro';

const links = [
	{ label: 'Get started', href: href('/get-started') },
	{ label: 'What it checks', href: href('/what-it-checks') },
	{ label: 'Docs', href: href('/docs') },
	...(resourcesLive ? [{ label: 'Resources', href: href('/resources') }] : []),
	{ label: 'About', href: href('/about') },
	{ label: 'GitHub', href: GITHUB_URL },
];
---

<div class="sn">
	<a class="skip" href="#main">Skip to main content</a>
	<header>
		<div class="bar">
			<a class="lg" href={href('/')} aria-label="a11ign, home"><Logo class="logo" alt="" /></a>
			<nav class="dn" aria-label="Main">
				{links.map((link) => <a class="nl" href={link.href}>{link.label}</a>)}
			</nav>
			<div style="flex:1 1 auto"></div>
			<StarPill />
			<button type="button" class="tg" aria-label="Switch to light theme" data-theme-toggle>
				<svg class="ic-sun" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
				<svg class="ic-moon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"></path></svg>
			</button>
			<div class="dcta"><Button href={href('/get-started')}>Get started</Button></div>
			<button type="button" class="mb" aria-expanded="false" aria-controls="a11ign-menu" aria-label="Open menu" data-menu-button>
				<svg class="ic-open" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
				<svg class="ic-close" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
			</button>
		</div>
		<nav id="a11ign-menu" class="mpanel" aria-label="Main menu">
			{links.map((link) => <a class="mi" href={link.href}>{link.label}</a>)}
			<a class="a1-btn a1-btn-primary a1-btn-lg" href={href('/get-started')} style="margin-top:20px;width:100%">Get started</a>
		</nav>
	</header>
</div>

<script>
	import { setupMenu } from '../scripts/menu';
	import { setupThemeToggle } from '../scripts/theme';
	setupMenu();
	setupThemeToggle();
</script>

<style is:global>
	.sn, .sn * { box-sizing: border-box; }
	.sn { position: relative; width: 100%; background: var(--ground); color: var(--text); font-family: var(--font-sans); }
	.bar { display: flex; align-items: center; gap: 20px; padding: 16px 80px; min-height: 96px; border-bottom: 1px solid var(--divider); background: var(--ground); }
	.logo { height: 32px; width: auto; display: block; }
	.nl { display: inline-flex; align-items: center; min-height: var(--touch-target); min-width: var(--touch-target); padding: 0 14px; color: var(--text); font: 500 18px/1.2 var(--font-sans); text-decoration: none; }
	.nl:hover { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 2px; }
	.nl:focus-visible, .mb:focus-visible, .lg:focus-visible, .skip:focus-visible, .mi:focus-visible, .tg:focus-visible { outline: var(--focus-width) solid var(--focus); outline-offset: 3px; border-radius: 8px; }
	.tg { display: none; align-items: center; justify-content: center; flex: none; width: 44px; height: 44px; border: 2px solid var(--edge); border-radius: var(--radius-md); background: transparent; color: var(--text); cursor: pointer; padding: 0; }
	.tg:hover { background: var(--raised); }
	/* The theme toggle and the menu button need JavaScript, so without it they are not shown. */
	html.js .tg { display: inline-flex; }
	.ic-moon { display: none; }
	[data-theme="light"] .ic-sun { display: none; }
	[data-theme="light"] .ic-moon { display: block; }
	.lgl { display: none; }
	[data-theme="light"] .lgd { display: none; }
	[data-theme="light"] .lgl { display: block; }
	.mb { display: none; align-items: center; justify-content: center; width: 44px; height: 44px; border: 2px solid var(--edge); border-radius: var(--radius-md); background: transparent; color: var(--text); cursor: pointer; padding: 0; }
	.mb:hover { background: var(--raised); }
	.mb .ic-close, .mb[aria-expanded="true"] .ic-open { display: none; }
	.mb[aria-expanded="true"] .ic-close { display: block; }
	.lg { display: inline-flex; align-items: center; min-height: 44px; }
	.skip { position: absolute; left: 12px; top: -80px; z-index: 5; padding: 12px 18px; border-radius: var(--radius-md); background: var(--pen); color: var(--ink); font: 600 18px/1.2 var(--font-sans); text-decoration: none; }
	.skip:focus { top: 12px; }
	.dn { display: flex; gap: 4px; margin-left: 16px; }
	.dcta { display: block; }
	.mpanel { display: none; }
	.mi { display: flex; align-items: center; min-height: 56px; color: var(--text); font: 600 20px/1.2 var(--font-sans); text-decoration: none; border-bottom: 1px solid var(--divider); }
	@media (max-width: 1180px) { .nl { padding: 0 9px; font-size: 16px; } .bar { padding-left: 32px; padding-right: 32px; } }
	/* Between the design's two layouts the full nav needs a little less room than the 1440 board gives it. */
	@media (max-width: 1000px) { .nl { padding: 0 4px; } .bar { gap: 12px; padding-left: 20px; padding-right: 20px; } .dn { margin-left: 4px; } }
	@media (max-width: 860px) {
		.bar { padding: 14px 20px; min-height: 72px; gap: 12px; }
		.logo { height: 26px; }
		.dn, .dcta { display: none; }
		html.js .mb { display: inline-flex; }
		.mpanel.on, html:not(.js) .mpanel { display: flex; flex-direction: column; padding: 4px 20px 24px; background: var(--ground); border-bottom: 1px solid var(--divider); }
	}
</style>
